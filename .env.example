# Copia este archivo como .env para ejecutar en local.
# En Railway estas variables las configura el docente.

# URL interna de la API de entradas (Equipo 5). Se consulta {ENTRADAS_URL}/entradas/{codigo}
ENTRADAS_URL=http://localhost:8001

# URL interna de la API de eventos. Se consulta {EVENTOS_URL}/eventos/{evento_id}
EVENTOS_URL=http://localhost:8002

# Opcional: segundos de espera máxima por cada API externa (por defecto 5)
HTTP_TIMEOUT_SEGUNDOS=5
